{
  "name": "@lentjs/core",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.d.ts"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./jsx-runtime.d.ts",
        "import": "./jsx-runtime.d.ts"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./jsx-dev-runtime.d.ts",
        "import": "./jsx-dev-runtime.d.ts"
      }
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/bun": "latest",
    "happy-dom": "^20.9.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "build": "bunup",
    "check-types": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,mjs,cjs,ts,tsx,jsx,mts,cts}'",
    "test": "bun test"
  },
  "dependencies": {
    "csstype": "^3.2.3",
    "@lentjs/utils": "workspace:*",
    "@lentjs/core-serialize": "workspace:*",
    "@lentjs/core-reactivity": "workspace:*"
  }
}
