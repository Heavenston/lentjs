{
  "name": "@lentjs/core-serialize",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bunup",
    "check-types": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,mjs,cjs,ts,tsx,jsx,mts,cts}'"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "devalue": "^5.6.4",
    "@lentjs/utils": "workspace:*"
  }
}
